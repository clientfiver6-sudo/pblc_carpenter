# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── App URL ────────────────────────────────────────────────────────────────────
# Set to your production domain in prod (e.g. https://app.retornai.com.br)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Security keys ──────────────────────────────────────────────────────────────
# ENCRYPTION_KEY: 64 hex chars (32 bytes). Required — app crashes in prod without it.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# CRON_SECRET: 32+ chars. Must match the cron auth check in vercel.json cron headers.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# SEED_SECRET: required to call /api/dev/seed (dev/staging only; route is blocked in prod).
# Keep it distinct from CRON_SECRET. Generate the same way.
SEED_SECRET=

# SEED_DEMO_PASSWORD: password assigned to the demo accounts created by /api/dev/seed.
SEED_DEMO_PASSWORD=

# ── AI ─────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# DeepSeek (optional — used for briefings and ambient AI to cut costs ~10x)
DEEPSEEK_API_KEY=

# ── WhatsApp / Evolution API ───────────────────────────────────────────────────
# Required for all WhatsApp messaging features.
# Self-host Evolution API: https://github.com/EvolutionAPI/evolution-api
EVOLUTION_API_URL=https://your-evolution-instance.com
EVOLUTION_API_KEY=

# ── Mercado Pago ───────────────────────────────────────────────────────────────
# OAuth credentials (from MP developer panel → Application)
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=

# Platform access token (your master MP account — for subscription billing)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PLATFORM_ACCESS_TOKEN=

# Webhook secrets (from MP developer panel → Webhooks → Secret key)
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_SUBSCRIPTION_WEBHOOK_SECRET=

# Subscription plan IDs (create plans in MP dashboard)
MERCADOPAGO_STARTER_PLAN_ID=
MERCADOPAGO_PRO_PLAN_ID=

# ── Rate limiting / Upstash Redis ─────────────────────────────────────────────
# Optional in dev (falls back to in-memory), required in prod for multi-instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Email / SMTP ───────────────────────────────────────────────────────────────
# Gmail with App Password (not your login password).
# Enable 2FA → Google Account → Security → App Passwords
EMAIL_USER=
EMAIL_PASSWORD=

# Recipient for scripts/send-demo-emails.mjs (demo email previews)
DEMO_EMAIL_TO=

# ── E2E test credentials (test-*.mjs scripts, optional) ──────────────────────
TEST_EMAIL=
TEST_PASSWORD=
TEST_ADMIN_PASSWORD=
# Optional override of seed-prod.mjs target (host only, e.g. yourproject.supabase.co)
SUPABASE_HOST=

# ── Cloudflare Turnstile (captcha) ────────────────────────────────────────────
# Optional in dev (skipped when keys absent), required in prod.
# Get keys at: https://dash.cloudflare.com → Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Twilio (voice calls — optional) ──────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_DID_NUMBER=

# ── Deepgram (medical audio transcription — optional) ─────────────────────────
DEEPGRAM_API_KEY=
